---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import "../styles/global.css";

const allPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true }),
);
const pageTitle: string = "Mon blog d'apprentissage";
---

<BaseLayout pageTitle={pageTitle}>
  <p>
    Lorem ipsum dolor sit, amet consectetur adipisicing elit. Et, quia? Numquam
    a cupiditate omnis obcaecati incidunt eos, nemo ratione autem repellat
    libero fugiat quaerat alias fuga dolor corrupti magnam cumque.
  </p>
  <ul>
    {
      allPosts.map((post: any) => (
        <BlogPost url={post.url} title={post.frontmatter.title} />
      ))
    }
  </ul>
</BaseLayout>
